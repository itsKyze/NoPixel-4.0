{
  "name": "nopixel-resources",
  "version": "1.0.0",
  "private": true,
  "description": "NoPixel 4.0 Monorepo Workspace",
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "build": "node tools/build-all.js",
    "build:all": "node tools/build-all.js --obfuscate",
    "build:clean": "node tools/build-all.js --force",
    "build:scripts": "node tools/build-all.js --scripts",
    "build:nui": "node tools/build-all.js --nui",
    "watch": "node tools/build-all.js --watch"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "javascript-obfuscator": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "turbo": "^2.0.0",
    "vite": "^8.3.0"
  }
}